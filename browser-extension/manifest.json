{
  "manifest_version": 3,
  "name": "Cash App Pay Injector (Demo)",
  "version": "0.1.0",
  "description": "Injects a Cash App Pay button into visited pages (demo).",
  "permissions": ["activeTab","scripting","tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "css": ["content-style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Cash App Pay Injector"
  }
}
