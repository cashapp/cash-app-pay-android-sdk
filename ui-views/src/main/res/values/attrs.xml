<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Named after the view, as declare-styleable convention requires; its attributes carry the cap_ prefix. -->
  <declare-styleable name="CashAppPayButton" tools:ignore="ResourceName">
    <!-- Text shown on the button. Defaults to cash_app_pay. -->
    <attr name="cap_label" format="enum">
      <enum name="cash_app" value="0" />
      <enum name="pay" value="1" />
      <enum name="buy" value="2" />
      <enum name="cash_out" value="3" />
      <enum name="checkout" value="4" />
      <!-- Not "continue": Android rejects reserved Java keywords as resource names. -->
      <enum name="continue_with" value="5" />
      <enum name="cash_app_pay" value="6" />
      <enum name="connect" value="7" />
    </attr>
    <!-- Color variant, set by the CAPButtonStyle styles. -->
    <attr name="cap_variant" format="enum">
      <!-- Not "default": Android rejects reserved Java keywords as resource names. -->
      <enum name="default_style" value="0" />
      <enum name="alt" value="1" />
      <enum name="monochrome_dark" value="2" />
      <enum name="monochrome_light" value="3" />
      <enum name="light" value="4" />
    </attr>
  </declare-styleable>
  <declare-styleable name="CashAppPaymentMethod" tools:ignore="ResourceName">
    <!-- The customer's cashtag. -->
    <attr name="cap_cashtag" format="string" />
    <!-- Layout: small puts the cashtag under the logo, large puts it to the right. -->
    <attr name="cap_size" format="enum">
      <enum name="small" value="0" />
      <enum name="large" value="1" />
    </attr>
    <!-- true for the polychrome logo, false for the monochrome logo. With cash_app_pay, the polychrome logo is the
         green Cash App icon on a black background in light mode, and the black icon on a green background in dark
         mode. With cash_app, it is the green Cash App icon on a black background in light and dark mode. -->
    <attr name="cap_use_polychrome_asset" format="boolean" />
    <!-- Label shown, drawn as a logo: cash_app_pay (default) or cash_app. Shared with CashAppPayButton. -->
    <attr name="cap_label" />
  </declare-styleable>
</resources>
