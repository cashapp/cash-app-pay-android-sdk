<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="CAPButtonStyle" parent="android:Widget.ImageButton">
    <item name="android:minHeight">48dp</item>
    <item name="android:height">48dp</item>
  </style>

  <style name="CAPButtonStyle.Black">
    <item name="android:background">@drawable/cap_btn_background_dark</item>
    <item name="cap_variant">black</item>
  </style>

  <style name="CAPButtonStyle.White">
    <item name="android:background">@drawable/cap_btn_background_white</item>
    <item name="cap_variant">white</item>
  </style>

  <style name="CAPButtonStyle.MonochromeBlack">
    <item name="android:background">@drawable/cap_btn_background_dark</item>
    <item name="cap_variant">monochrome_black</item>
  </style>

  <style name="CAPButtonStyle.MonochromeWhite">
    <item name="android:background">@drawable/cap_btn_background_white</item>
    <item name="cap_variant">monochrome_white</item>
  </style>

  <style name="CAPButtonStyle.Green">
    <item name="android:background">@drawable/cap_btn_background_green</item>
    <item name="cap_variant">green</item>
  </style>

  <!-- Follows the system UI mode: Black in light mode, White in dark mode (see values-night). -->
  <style name="CAPButtonStyle.Auto" parent="CAPButtonStyle.Black" />

  <!-- Follows the system UI mode: MonochromeBlack in light mode, MonochromeWhite in dark mode (see values-night). -->
  <style name="CAPButtonStyle.MonochromeAuto" parent="CAPButtonStyle.MonochromeBlack" />

</resources>
